{
  "expo": {
    "name": "FaceAuthModule",
    "slug": "FaceAuthModule",
    "version": "1.0.0",
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "react-native-vision-camera"
    ],
    "android": {
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
